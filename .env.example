ANTHROPIC_FOUNDRY_BASE_URL=https://your-foundry-endpoint.azure-api.net/anthropic
ANTHROPIC_FOUNDRY_API_KEY=your-api-key-here

# Splunk (Phase 2 — live log queries)
SPLUNK_URL=https://localhost:8089
SPLUNK_USER=admin
SPLUNK_PASSWORD=your-splunk-password

# Prometheus (Phase 2 — live metrics queries)
PROMETHEUS_URL=http://localhost:9090

# Escalation email (sent when an approval is rejected or times out; optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=app-password-here
ALERT_EMAIL_TO=oncall@example.com
# ALERT_EMAIL_FROM=argus@example.com
# SMTP_STARTTLS=0   # set to 0 for plain local test servers
